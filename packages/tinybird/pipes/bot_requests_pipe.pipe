TAGS "Convrs Bot Detection"

NODE endpoint
TYPE endpoint
SQL >
%
SELECT
    timestamp,
    vendor,
    agent_name,
    category,
    hostname,
    page,
    status_code,
    verification,
    match_type,
    classifier_version,
    country,
    authenticated
FROM bot_traffic_events
WHERE
    workspace_id = {{ String(workspaceId) }}
    {% if defined(domain) %} AND domain = {{ String(domain) }} {% end %}
    {% if defined(category) %} AND category = {{ String(category) }} {% end %}
    {% if defined(verification) %} AND verification = {{ String(verification) }} {% end %}
    {% if defined(authenticated) %} AND authenticated = {{ UInt8(authenticated) }} {% end %}
    {% if defined(vendor) %} AND vendor = {{ String(vendor) }} {% end %}
    AND timestamp >= {{ DateTime64(start) }}
    AND timestamp <= {{ DateTime64(end) }}
ORDER BY timestamp DESC
LIMIT {{ Int32(limit, 50, required=False) }}
