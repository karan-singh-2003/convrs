TAGS "Convrs Bot Detection"

NODE endpoint
TYPE endpoint
SQL >
%
SELECT
    COUNT(*) AS total_requests,
    countIf(category = 'answer_agent') AS ai_answers,
    countIf(category = 'index_crawler') AS indexing,
    countIf(category = 'training_crawler') AS training,
    countIf(category = 'other') AS other,
    uniqExact(vendor) AS unique_providers
FROM bot_traffic_events
WHERE
    workspace_id = {{ String(workspaceId) }}
    {% if defined(domain) %} AND domain = {{ String(domain) }} {% end %}
    {% if defined(start) %} AND timestamp >= {{ DateTime64(start) }} {% end %}
    {% if defined(end) %} AND timestamp <= {{ DateTime64(end) }} {% end %}
