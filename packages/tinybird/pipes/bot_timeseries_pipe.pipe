TAGS "Convrs Bot Detection"

NODE endpoint
TYPE endpoint
SQL >
%
SELECT
    {% if String(granularity, 'day') == 'hour' %}
        toStartOfHour(timestamp) AS bucket_start
    {% elif String(granularity, 'day') == 'week' %}
        toStartOfInterval(timestamp, INTERVAL 1 week) AS bucket_start
    {% else %}
        toStartOfDay(timestamp) AS bucket_start
    {% end %},
    vendor,
    category,
    COUNT(*) AS requests
FROM bot_traffic_events
WHERE
    workspace_id = {{ String(workspaceId) }}
    {% if defined(domain) %} AND domain = {{ String(domain) }} {% end %}
    {% if defined(category) %} AND category = {{ String(category) }} {% end %}
    AND timestamp >= {{ DateTime64(start) }}
    AND timestamp <= {{ DateTime64(end) }}
GROUP BY bucket_start, vendor, category
ORDER BY bucket_start ASC
LIMIT 10000
