enum CustomerSubscriptionStatus {
  active
  trialing
  past_due
  paused
  canceled
}

enum SubscriptionInterval {
  day
  week
  month
  year
}

model Payment {
  id                     String            @id @default(cuid())
  workspaceId            String
  customerId             String
  provider               RevenueProvider   @default(stripe)

  // Generic external references (replaces stripeSessionId/stripeEventId/stripePaymentIntent)
  externalSessionId      String?           // checkout session / order / transaction id
  externalEventId        String?           // webhook delivery id, for idempotency
  externalPaymentId      String?           // payment intent / charge / payment id

  amount                 Int               // in cents (smallest currency unit)
  currency               String
  customerEmail          String?

  // Recurring-payment tagging (set when the payment settles a subscription).
  // MRR itself is computed from CustomerSubscription, not from these — these
  // exist so "recurring vs one-off" revenue can be split in the event stream.
  isRecurring            Boolean               @default(false)
  billingInterval        SubscriptionInterval?
  plan                   String?

  // Attribution
  attributionStatus      AttributionStatus @default(pending)
  attributedAt           DateTime?
  lastAttributionAttempt DateTime?
  visitorId              String?
  sessionId              String?

  // Tinybird sync
  tinybirdEventId        String?
  sentToTinybird         Boolean           @default(false)
  sentToTinybirdAt       DateTime?

  createdAt              DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  workspace              Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customer               Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([provider, externalSessionId])
  @@unique([provider, externalEventId])
  @@index([workspaceId])
  @@index([customerId])
  @@index([visitorId])
  @@index([attributionStatus])
}

// A customer's recurring subscription with a revenue provider (Stripe, Polar,
// Paddle, Dodo, LemonSqueezy). Upserted from provider webhook lifecycle events
// and used as the source of truth for Monthly Recurring Revenue: for any point
// in time, MRR = sum over subscriptions active at that point of `amount`
// normalized to a monthly figure (see monthlyAmount() in @repo/analytics).
model CustomerSubscription {
  id                     String                     @id @default(cuid())
  workspaceId            String
  customerId             String
  provider               RevenueProvider

  externalId             String                     // provider-side subscription id
  externalCustomerId     String?

  status                 CustomerSubscriptionStatus @default(active)

  amount                 Int                        // per-period price, smallest currency unit
  currency               String
  interval               SubscriptionInterval       @default(month)
  intervalCount          Int                        @default(1)
  plan                   String?

  startedAt              DateTime
  canceledAt             DateTime?
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?

  // Attribution (mirrors Payment)
  attributionStatus      AttributionStatus          @default(pending)
  attributedAt           DateTime?
  lastAttributionAttempt DateTime?
  visitorId              String?
  sessionId              String?

  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt

  workspace              Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customer               Customer                   @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([provider, externalId])
  @@index([workspaceId])
  @@index([customerId])
  @@index([workspaceId, status])
  @@index([workspaceId, startedAt])
  @@index([visitorId])
}