model Payment {
  id                     String            @id @default(cuid())
  workspaceId            String
  customerId             String
  provider               RevenueProvider   @default(stripe)

  // Generic external references (replaces stripeSessionId/stripeEventId/stripePaymentIntent)
  externalSessionId      String?           // checkout session / order / transaction id
  externalEventId        String?           // webhook delivery id, for idempotency
  externalPaymentId      String?           // payment intent / charge / payment id

  amount                 Int               // in cents (smallest currency unit)
  currency               String
  customerEmail          String?

  // Attribution
  attributionStatus      AttributionStatus @default(pending)
  attributedAt           DateTime?
  lastAttributionAttempt DateTime?
  visitorId              String?
  sessionId              String?

  // Tinybird sync
  tinybirdEventId        String?
  sentToTinybird         Boolean           @default(false)
  sentToTinybirdAt       DateTime?

  createdAt              DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  workspace              Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customer               Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([provider, externalSessionId])
  @@unique([provider, externalEventId])
  @@index([workspaceId])
  @@index([customerId])
  @@index([visitorId])
  @@index([attributionStatus])
}